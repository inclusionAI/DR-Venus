# Copy this file to .env. Never commit the populated .env file.

GLOO_SOCKET_IFNAME=eth0
SERPER_KEY_ID=your-serper-key
JINA_API_KEYS=your-jina-key

# Page summarizer endpoint.
API_KEY=your-api-key
API_BASE=https://your-endpoint.example/v1
SUMMARY_MODEL_NAME=your-summary-model

# Outcome-reward judge. JUDGE_API_* may be left empty to reuse API_*.
JUDGE_MODEL_NAME=your-judge-model
JUDGE_API_BASE=
JUDGE_API_KEY=
ENABLE_JUDGE_THINKING=true
# Optional stable opaque deployment id. It becomes part of the Judge cache key;
# otherwise a credential-free normalized JUDGE_API_BASE is used.
JUDGE_PROVIDER_ID=
JUDGE_SEED=42
JUDGE_TIMEOUT_SECONDS=300
JUDGE_CACHE_MODE=record
JUDGE_CACHE_PATH=./artifacts/judge_cache.jsonl

PROXY=

# Reproducible tool I/O: online, record, or replay.
TOOL_CACHE_MODE=replay
TOOL_CACHE_PATH=./artifacts/tool_cache.jsonl
