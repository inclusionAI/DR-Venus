# Copy this file to .env. Never commit the populated .env file.

# Multi-GPU network interface (change for your host, e.g. eth0/ens5/ib0).
GLOO_SOCKET_IFNAME=eth0

# Search and page-reading services.
SERPER_KEY_ID=your-serper-key
JINA_API_KEYS=your-jina-key

# OpenAI-compatible page summarizer.
API_KEY=your-api-key
API_BASE=https://your-endpoint.example/v1
SUMMARY_MODEL_NAME=your-summary-model

# Immutable Hugging Face commit/tag for remote checkpoints used in cohort eval.
CHECKPOINT_REVISION=

# Leave empty when no proxy is required.
PROXY=

# Reproducible tool I/O: online, record, or replay.
TOOL_CACHE_MODE=replay
TOOL_CACHE_PATH=./artifacts/tool_cache.jsonl

# End-to-end wall-clock budget shared by all HTTP retries in one tool call.
TOOL_TIMEOUT_SECONDS=150
